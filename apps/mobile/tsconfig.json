{
  "extends": "@steryle/config/typescript/react-native",
  "compilerOptions": {
    "types": ["react", "nativewind/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@steryle/core": ["../../packages/core/src/index.ts"],
      "@steryle/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
