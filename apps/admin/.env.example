# Proxied to the SST API (local default matches `pnpm dev:api`).
API_URL=http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:8787

# DynamoDB (admin SSR talks to the table directly, same as Amplify with IAM).
# Set TABLE_NAME after `pnpm deploy:backend`. Prefer AWS_PROFILE=steryle-admin locally.
# TABLE_NAME=
AWS_REGION=ap-south-1
