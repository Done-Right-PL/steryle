# Postgres connection string used by drizzle-kit and the seed script.
# Neon/Supabase pooled URLs work as-is; add ?sslmode=require for hosted instances.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stryle

# Bootstrap admin account created by `pnpm --filter @stryle/db seed`.
ADMIN_EMAIL=admin@stryle.in
ADMIN_PASSWORD=change-me-before-deploying
