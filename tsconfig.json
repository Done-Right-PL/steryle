{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@steryle/core": ["./packages/core/src/index.ts"],
      "@steryle/core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["packages/core/src/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "**/.next", "**/.expo"]
}
